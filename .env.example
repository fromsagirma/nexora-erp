# ============================================================
# BACKEND SERVER
# ============================================================

PORT=8000

# ============================================================
# AUTHENTICATION
# ============================================================

JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=15m

# ============================================================
# DATABASE
# ============================================================

POSTGRES_ADMIN_PASSWORD=your_postgres_admin_password
NEXORA_MIGRATOR_PASSWORD=your_nexora_migrator_password
NEXORA_APP_PASSWORD=your_nexora_app_password

DATABASE_URL_MIGRATOR=postgresql://nexora_migrator:YOUR_PASSWORD@localhost:5433/nexora_erp?schema=public

DATABASE_URL_APP=postgresql://nexora_app:YOUR_PASSWORD@localhost:5433/nexora_erp?schema=public